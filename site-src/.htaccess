# Static site cutover: route canonical paths to static files and stop WordPress rewrites.
Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteRule ^storydonkey-privacy/?$ /storydonkey-privacy-static.html [L]
RewriteRule ^storydonkey-terms/?$ /storydonkey-terms-static.html [L]
RewriteRule ^storydonkey-support/?$ /storydonkey-support-static.html [L]
